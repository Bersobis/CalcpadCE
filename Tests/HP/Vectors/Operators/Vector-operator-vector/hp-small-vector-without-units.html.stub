   6; -2.5; 0; 4.3; -8.1
   <span class="b0">]</span>
   )  =
   <span class="matrix">
    <span class="tr">
     <span class="td">
     </span>
     <span class="td">6</span>
     <span class="td">-2.5</span>
     <span class="td">0</span>
     <span class="td">4.3</span>
     <span class="td">-8.1</span>
