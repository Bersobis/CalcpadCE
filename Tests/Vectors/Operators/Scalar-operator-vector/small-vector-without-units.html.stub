 <h1>Relational operators</h1>
 <h3>Equal to</h3>
 <p>
  <span class="eq">
   <var>a</var>
   = 8.2
  </span>
 </p>
 <p>
  <span class="eq">
   <var>
    <span class="vec">⃗</span>
    b
   </var>
   =
   <span class="b0">[</span>
   8.2; 0; 6.9; -2.8; 3; 8.2; -7; 4.6
   <span class="b0">]</span>
   =
   <span class="matrix">
    <span class="tr">
     <span class="td">
     </span>
     <span class="td">8.2</span>
     <span class="td">0</span>
     <span class="td">6.9</span>
     <span class="td">-2.8</span>
     <span class="td">3</span>
     <span class="td">8.2</span>
     <span class="td">-7</span>
     <span class="td">4.6</span>
     <span class="td">
     </span>
    </span>
   </span>
  </span>
 </p>
 <p>
  <span class="eq">
   <var>
    <span class="vec">⃗</span>
    c
   </var>
   =
   <var>a</var>
   ≡
   <var>
    <span class="vec">⃗</span>
    b
   </var>
   = 8.2 ≡
   <var>
    <span class="vec">⃗</span>
    b
   </var>
   =
   <span class="matrix">
    <span class="tr">
     <span class="td">
     </span>
     <span class="td">1</span>
     <span class="td">0</span>
     <span class="td">0</span>
     <span class="td">0</span>
